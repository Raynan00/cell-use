<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleDisplayName</key><string>cell-use</string>
  <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.1.0</string>
  <key>CFBundleVersion</key><string>21</string>
  <key>UIBackgroundModes</key><array><string>processing</string></array>
  <key>BGTaskSchedulerPermittedIdentifiers</key><array><string>com.raynan.celluse.probe.*</string></array>
  <key>NSLocalNetworkUsageDescription</key><string>Connect this iPhone to its own developer services to test on-device screen observation and input.</string>
  <key>NSBonjourServices</key><array>
    <string>_remotepairing-pairable-host._tcp</string>
    <string>_remotepairing._tcp</string>
    <string>_remotepairing-manual-pairing._tcp</string>
  </array>
  <key>UILaunchScreen</key><dict/>
  <key>UIApplicationSceneManifest</key><dict><key>UIApplicationSupportsMultipleScenes</key><false/></dict>
  <key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
  <key>UIRequiredDeviceCapabilities</key><array><string>arm64</string></array>
  <key>LSRequiresIPhoneOS</key><true/>
</dict></plist>
